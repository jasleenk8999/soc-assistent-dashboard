# AI Cyber Security SOC Assistant Environment Configuration

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soc_assistant

# Authentication (Phase 2)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Python ML Microservice (Phase 7-8)
ML_SERVICE_URL=http://localhost:8000

# LLM Incident Explanation (Phase 5 - optional)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Threat Intelligence APIs (Phase 6 - optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ALIENVAULT_OTX_API_KEY=your_alienvault_api_key_here
